// ── FINGERPRINT (1 resposta / dispositivo) ──────
function getFingerprint() {
  const nav = window.navigator;
  const scr = window.screen;
  const raw = [
    nav.userAgent, nav.language, nav.hardwareConcurrency,
    scr.width, scr.height, scr.colorDepth,
    nav.platform, Intl.DateTimeFormat().resolvedOptions().timeZone,
    nav.cookieEnabled, typeof nav.bluetooth !== 'undefined',
  ].join('|');
  let hash = 0;
  for(let i = 0; i < raw.length; i++) {
    hash = ((hash << 5) - hash) + raw.charCodeAt(i);
    hash |= 0;
  }
  return 'fp_' + Math.abs(hash).toString(36);
}

function hasResponded() {
  const fp = getFingerprint();
  const stored = localStorage.getItem(KEY_FINGERPRINT);
  return stored === fp;
}

function markResponded() {
  localStorage.setItem(KEY_FINGERPRINT, getFingerprint());
}

