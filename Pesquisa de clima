<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pesquisa de Clima Organizacional</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
:root {
  --blue-deep:#1B3A6B;--blue-mid:#2557A7;--blue-light:#EBF0FA;
  --green:#2E7D5E;--green-light:#E8F5EF;
  --amber:#E8A020;--amber-light:#FEF3DC;
  --red:#C0392B;--red-light:#FDECEA;
  --gray-100:#F5F7FA;--gray-200:#E8ECF2;--gray-400:#9BA8BB;
  --gray-600:#5A6478;--gray-800:#2C3447;--white:#FFFFFF;
  --shadow-sm:0 1px 4px rgba(27,58,107,.08);
  --shadow-md:0 4px 16px rgba(27,58,107,.12);
  --shadow-lg:0 8px 32px rgba(27,58,107,.18);
  --radius:12px;--radius-sm:8px;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',sans-serif;background:var(--gray-100);color:var(--gray-800);min-height:100vh}

/* ── HEADER ── */
.app-header{background:var(--blue-deep);color:#fff;padding:0 20px;height:58px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;box-shadow:var(--shadow-md)}
.logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:15px;letter-spacing:-.3px}
.logo-icon{width:32px;height:32px;background:var(--blue-mid);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px}
.nav-tabs{display:flex;gap:4px}
.nav-tab{padding:6px 13px;border-radius:6px;border:none;background:transparent;color:rgba(255,255,255,.6);font-family:'Inter',sans-serif;font-size:13px;font-weight:500;cursor:pointer;transition:all .2s}
.nav-tab:hover,.nav-tab.active{background:rgba(255,255,255,.18);color:#fff}

/* ── VIEWS ── */
.view{display:none}.view.active{display:block}

/* ── SURVEY ── */
.survey-wrap{max-width:700px;margin:0 auto;padding:28px 16px 60px}
.anon-banner{background:var(--green-light);border:1.5px solid #A3D4BF;border-radius:var(--radius);padding:16px 18px;display:flex;gap:12px;align-items:flex-start;margin-bottom:24px}
.anon-banner .shield{font-size:22px;flex-shrink:0}
.anon-banner h3{font-size:13px;font-weight:700;color:var(--green);margin-bottom:3px}
.anon-banner p{font-size:12.5px;color:#3a6e57;line-height:1.55}
.survey-header{margin-bottom:28px;text-align:center}
.survey-header h1{font-size:24px;font-weight:800;color:var(--blue-deep);letter-spacing:-.5px}
.survey-header p{font-size:13.5px;color:var(--gray-600);margin-top:7px;line-height:1.6}
.progress-wrap{margin-bottom:24px}
.progress-label{display:flex;justify-content:space-between;font-size:12px;color:var(--gray-400);margin-bottom:7px;font-weight:500}
.progress-bar{height:6px;background:var(--gray-200);border-radius:99px;overflow:hidden}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--blue-mid),#4A90D9);border-radius:99px;transition:width .4s ease}
.survey-section{background:#fff;border-radius:var(--radius);padding:22px;margin-bottom:18px;box-shadow:var(--shadow-sm);border:1px solid var(--gray-200)}
.section-title{display:flex;align-items:center;gap:10px;margin-bottom:18px}
.section-icon{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:17px;background:var(--blue-light)}
.section-title h2{font-size:15px;font-weight:700;color:var(--blue-deep)}
.question-item{margin-bottom:18px}.question-item:last-child{margin-bottom:0}
.question-text{font-size:13px;color:var(--gray-800);margin-bottom:9px;font-weight:500;line-height:1.5}
.scale-row{display:flex;gap:5px}
.scale-btn{flex:1;height:44px;border-radius:var(--radius-sm);border:1.5px solid var(--gray-200);background:var(--gray-100);cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:'Inter',sans-serif;font-size:15px;font-weight:700;color:var(--gray-600);transition:all .15s}
.scale-btn:hover{border-color:var(--blue-mid);color:var(--blue-mid);background:var(--blue-light)}
.scale-btn.selected-1{background:#FDECEA;border-color:var(--red);color:var(--red)}
.scale-btn.selected-2{background:#FEF3DC;border-color:var(--amber);color:#c47d0a}
.scale-btn.selected-3{background:#F0EEF8;border-color:#7B6DC8;color:#5a50a0}
.scale-btn.selected-4{background:#E8F5EF;border-color:#4aad82;color:#2a7d58}
.scale-btn.selected-5{background:#E8F0FB;border-color:var(--blue-mid);color:var(--blue-mid)}
.scale-label{font-size:9px;font-weight:400;line-height:1.2;text-align:center;margin-top:2px;display:none}
@media(min-width:460px){.scale-label{display:block}}
.open-question{margin-bottom:18px}.open-question:last-child{margin-bottom:0}
.open-question label{display:block;font-size:13px;font-weight:500;color:var(--gray-800);margin-bottom:7px;line-height:1.5}
.open-question textarea{width:100%;min-height:85px;border:1.5px solid var(--gray-200);border-radius:var(--radius-sm);padding:11px;font-family:'Inter',sans-serif;font-size:13px;color:var(--gray-800);resize:vertical;transition:border-color .2s;background:var(--gray-100)}
.open-question textarea:focus{outline:none;border-color:var(--blue-mid);background:#fff}
.open-question textarea::placeholder{color:var(--gray-400)}
.submit-area{text-align:center;margin-top:28px}
.btn-primary{background:var(--blue-deep);color:#fff;border:none;padding:13px 38px;border-radius:var(--radius-sm);font-family:'Inter',sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:all .2s;box-shadow:0 4px 12px rgba(27,58,107,.28)}
.btn-primary:hover{background:var(--blue-mid);transform:translateY(-1px);box-shadow:0 6px 16px rgba(27,58,107,.35)}
.success-screen{display:none;text-align:center;padding:56px 24px;background:#fff;border-radius:var(--radius);box-shadow:var(--shadow-sm)}
.success-screen.show{display:block}
.success-icon{font-size:60px;margin-bottom:18px}
.success-screen h2{font-size:22px;font-weight:800;color:var(--green);margin-bottom:10px}
.success-screen p{color:var(--gray-600);line-height:1.6;max-width:400px;margin:0 auto}

/* Already responded */
.already-screen{display:none;text-align:center;padding:56px 24px;background:#fff;border-radius:var(--radius);box-shadow:var(--shadow-sm)}
.already-screen.show{display:block}

/* ── LOGIN ── */
.login-overlay{display:none;position:fixed;inset:0;background:rgba(27,58,107,.6);z-index:200;align-items:center;justify-content:center;backdrop-filter:blur(4px)}
.login-overlay.show{display:flex}
.login-box{background:#fff;border-radius:16px;padding:36px 32px;max-width:380px;width:100%;box-shadow:var(--shadow-lg);text-align:center}
.login-box h2{font-size:20px;font-weight:800;color:var(--blue-deep);margin-bottom:6px}
.login-box p{font-size:13px;color:var(--gray-600);margin-bottom:24px}
.login-box input{width:100%;padding:12px 14px;border:1.5px solid var(--gray-200);border-radius:var(--radius-sm);font-family:'Inter',sans-serif;font-size:14px;margin-bottom:12px;outline:none;transition:border-color .2s}
.login-box input:focus{border-color:var(--blue-mid)}
.login-error{color:var(--red);font-size:12px;margin-bottom:10px;display:none}
.login-error.show{display:block}

/* ── DASHBOARD ── */
.dashboard-wrap{padding:24px 16px 60px;max-width:1200px;margin:0 auto}
.dash-topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px}
.dash-topbar h1{font-size:21px;font-weight:800;color:var(--blue-deep)}
.dash-actions{display:flex;gap:8px;flex-wrap:wrap}
.btn-outline{background:#fff;border:1.5px solid var(--gray-200);color:var(--gray-600);padding:7px 14px;border-radius:var(--radius-sm);font-family:'Inter',sans-serif;font-size:13px;font-weight:500;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:6px}
.btn-outline:hover{border-color:var(--blue-mid);color:var(--blue-mid);background:var(--blue-light)}
.btn-ai{background:linear-gradient(135deg,#2557A7,#4A90D9);color:#fff;border:none;padding:7px 16px;border-radius:var(--radius-sm);font-family:'Inter',sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:6px;box-shadow:0 2px 8px rgba(37,87,167,.28)}
.btn-ai:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(37,87,167,.38)}
.btn-danger{background:var(--red-light);border:1.5px solid #e8b4b0;color:var(--red);padding:7px 14px;border-radius:var(--radius-sm);font-family:'Inter',sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:all .2s}
.btn-danger:hover{background:var(--red);color:#fff}
.responses-count{background:var(--blue-light);color:var(--blue-mid);font-size:12px;font-weight:600;padding:3px 11px;border-radius:99px;display:inline-block;margin-top:4px}
.metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:20px}
.metric-card{background:#fff;border-radius:var(--radius);padding:18px;box-shadow:var(--shadow-sm);border:1px solid var(--gray-200);position:relative;overflow:hidden}
.metric-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;border-radius:var(--radius) var(--radius) 0 0}
.metric-card.excellent::before{background:var(--green)}
.metric-card.good::before{background:#3AA76D}
.metric-card.attention::before{background:var(--amber)}
.metric-card.critical::before{background:var(--red)}
.metric-label{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:var(--gray-400);margin-bottom:7px}
.metric-value{font-size:30px;font-weight:800;letter-spacing:-1px;line-height:1}
.metric-value.excellent{color:var(--green)}.metric-value.good{color:#3AA76D}
.metric-value.attention{color:var(--amber)}.metric-value.critical{color:var(--red)}
.metric-badge{display:inline-block;margin-top:5px;font-size:10px;font-weight:700;padding:2px 7px;border-radius:99px;text-transform:uppercase;letter-spacing:.3px}
.metric-badge.excellent{background:var(--green-light);color:var(--green)}
.metric-badge.good{background:#E8F5EF;color:#3AA76D}
.metric-badge.attention{background:var(--amber-light);color:#c47d0a}
.metric-badge.critical{background:var(--red-light);color:var(--red)}
.dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px}
@media(max-width:760px){.dash-grid{grid-template-columns:1fr}}
.dash-card{background:#fff;border-radius:var(--radius);padding:18px;box-shadow:var(--shadow-sm);border:1px solid var(--gray-200)}
.dash-card.full{grid-column:1/-1}
.dash-card h3{font-size:13.5px;font-weight:700;color:var(--blue-deep);margin-bottom:14px;display:flex;align-items:center;gap:8px}
.dash-card h3 .badge{background:var(--blue-light);color:var(--blue-mid);font-size:10px;padding:2px 7px;border-radius:99px;font-weight:600}
.ranking-list{display:flex;flex-direction:column;gap:7px}
.ranking-item{display:flex;align-items:center;gap:9px;padding:9px 11px;border-radius:var(--radius-sm);background:var(--gray-100);border:1px solid var(--gray-200)}
.ranking-pos{width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;flex-shrink:0}
.ranking-name{flex:1;font-size:12.5px;font-weight:500}
.ranking-score{font-size:14px;font-weight:800}
.ranking-bar-wrap{flex:0 0 70px;height:5px;background:var(--gray-200);border-radius:99px;overflow:hidden}
.ranking-bar{height:100%;border-radius:99px}
.heatmap-grid{display:grid;gap:3px}
.heatmap-row{display:grid;grid-template-columns:175px repeat(5,1fr);gap:3px;align-items:center}
.heatmap-label{font-size:11px;color:var(--gray-600);font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:6px}
.heatmap-cell{height:26px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:#fff;transition:transform .2s;cursor:default}
.heatmap-cell:hover{transform:scale(1.06)}
.heatmap-header{display:grid;grid-template-columns:175px repeat(5,1fr);gap:3px;margin-bottom:3px}
.heatmap-header span{text-align:center;font-size:9px;font-weight:700;color:var(--gray-400);text-transform:uppercase;letter-spacing:.4px}
.open-answers{display:flex;flex-direction:column;gap:7px}
.open-answer-item{padding:10px 13px;background:var(--gray-100);border-radius:var(--radius-sm);border-left:3px solid var(--blue-mid);font-size:12.5px;line-height:1.6;color:var(--gray-600)}
.empty-state{text-align:center;padding:56px 24px;background:#fff;border-radius:var(--radius);box-shadow:var(--shadow-sm);border:1px solid var(--gray-200)}
.empty-state .icon{font-size:44px;margin-bottom:14px}
.empty-state h3{font-size:17px;font-weight:700;color:var(--blue-deep);margin-bottom:7px}
.empty-state p{color:var(--gray-600);font-size:13.5px;line-height:1.6}
/* AI Modal */
.ai-report-overlay{display:none;position:fixed;inset:0;background:rgba(27,58,107,.5);z-index:200;align-items:center;justify-content:center;padding:16px;backdrop-filter:blur(3px)}
.ai-report-overlay.show{display:flex}
.ai-report-modal{background:#fff;border-radius:16px;max-width:800px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow-lg)}
.ai-modal-header{background:linear-gradient(135deg,var(--blue-deep),var(--blue-mid));color:#fff;padding:22px;border-radius:16px 16px 0 0;display:flex;justify-content:space-between;align-items:flex-start}
.ai-modal-header h2{font-size:17px;font-weight:800;margin-bottom:3px}
.ai-modal-header p{font-size:11px;opacity:.75}
.btn-close{background:rgba(255,255,255,.2);border:none;color:#fff;width:30px;height:30px;border-radius:50%;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ai-modal-body{padding:22px}
.ai-section{margin-bottom:18px}
.ai-section-title{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:700;color:var(--blue-deep);margin-bottom:10px;padding-bottom:7px;border-bottom:1px solid var(--gray-200)}
.ai-loading{display:flex;flex-direction:column;align-items:center;padding:36px;text-align:center;gap:10px}
.ai-spinner{width:38px;height:38px;border:3px solid var(--blue-light);border-top-color:var(--blue-mid);border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.ai-content p{font-size:13px;line-height:1.7;color:var(--gray-800);margin-bottom:7px}
.ai-content ul{padding-left:18px}
.ai-content li{font-size:13px;line-height:1.7;color:var(--gray-800);margin-bottom:3px}
.action-table{width:100%;border-collapse:collapse;font-size:12.5px;margin-top:7px}
.action-table th{background:var(--blue-deep);color:#fff;padding:7px 11px;text-align:left;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.3px}
.action-table td{padding:7px 11px;border-bottom:1px solid var(--gray-200)}
.action-table tr:nth-child(even) td{background:var(--gray-100)}
.prio-badge{padding:2px 7px;border-radius:99px;font-size:10px;font-weight:700}
.prio-alta{background:var(--red-light);color:var(--red)}
.prio-media{background:var(--amber-light);color:#c47d0a}
.prio-baixa{background:var(--green-light);color:var(--green)}
/* Toast */
.toast{position:fixed;bottom:24px;right:24px;background:var(--gray-800);color:#fff;padding:12px 20px;border-radius:var(--radius-sm);font-size:13px;font-weight:500;box-shadow:var(--shadow-lg);z-index:999;transform:translateY(80px);opacity:0;transition:all .3s;pointer-events:none}
.toast.show{transform:translateY(0);opacity:1}
.toast.success{background:var(--green)}
.toast.error{background:var(--red)}
@media(max-width:500px){
  .heatmap-row,.heatmap-header{grid-template-columns:110px repeat(5,1fr)}
  .heatmap-label{font-size:10px}
}
</style>
</head>
<body>

<!-- ══ HEADER ══ -->
<header class="app-header">
  <div class="logo">
    <div class="logo-icon">🌡️</div>
    <span>Clima Organizacional</span>
  </div>
  <nav class="nav-tabs">
    <button class="nav-tab active" id="tab-survey" onclick="showView('survey',event)">📋 Responder Pesquisa</button>
    <button class="nav-tab" id="tab-dashboard" onclick="goToDashboard(event)">📊 Dashboard</button>
  </nav>
</header>

<!-- ══ LOGIN MODAL ══ -->
<div class="login-overlay" id="login-overlay">
  <div class="login-box">
    <div style="font-size:40px;margin-bottom:12px">🔐</div>
    <h2>Acesso Restrito</h2>
    <p>Esta área é exclusiva para gestores. Insira a senha para continuar.</p>
    <input type="password" id="login-input" placeholder="Digite a senha" onkeydown="if(event.key==='Enter')checkLogin()">
    <div class="login-error" id="login-error">Senha incorreta. Tente novamente.</div>
    <button class="btn-primary" style="width:100%" onclick="checkLogin()">Entrar</button>
  </div>
</div>

<!-- ══════════════════════════════════════
     SURVEY VIEW
══════════════════════════════════════ -->
<div id="view-survey" class="view active">
  <div class="survey-wrap">

    <!-- Already responded -->
    <div class="already-screen" id="already-screen">
      <div style="font-size:56px;margin-bottom:16px">✅</div>
      <h2 style="font-size:20px;font-weight:800;color:var(--blue-deep);margin-bottom:10px">Você já respondeu esta pesquisa</h2>
      <p style="color:var(--gray-600);line-height:1.6;max-width:380px;margin:0 auto">Sua resposta já foi registrada neste dispositivo. A pesquisa permite apenas 1 resposta por aparelho para garantir a integridade dos dados. Obrigado pela participação!</p>
    </div>

    <!-- Success screen -->
    <div class="success-screen" id="success-screen">
      <div class="success-icon">🎉</div>
      <h2>Obrigado pela participação!</h2>
      <p>Suas respostas foram registradas com sucesso de forma completamente anônima. Elas serão analisadas para melhorar o ambiente de trabalho.</p>
    </div>

    <!-- Survey form -->
    <div id="survey-form">
      <div class="anon-banner">
        <div class="shield">🛡️</div>
        <div>
          <h3>100% Anônimo — Seus dados estão protegidos</h3>
          <p>Esta pesquisa <strong>não coleta nome, e-mail, IP ou qualquer dado identificador</strong>. Suas respostas são completamente confidenciais e tratadas de forma agregada.</p>
        </div>
      </div>
      <div class="survey-header">
        <h1>Pesquisa de Clima Operacional</h1>
        <p>Sua opinião é fundamental. A pesquisa leva cerca de 5 minutos.</p>
      </div>
      <div class="progress-wrap">
        <div class="progress-label"><span>Progresso</span><span id="progress-text">0%</span></div>
        <div class="progress-bar"><div class="progress-fill" id="progress-fill" style="width:0%"></div></div>
      </div>

      <!-- LIDERANÇA -->
      <div class="survey-section">
        <div class="section-title"><div class="section-icon">👔</div><h2>Liderança</h2></div>
        <div class="question-item">
          <div class="question-text">1. Meu gestor fornece orientações claras.</div>
          <div class="scale-row">
            <button class="scale-btn" onclick="sel(this,1,'q1')">1<span class="scale-label">Muito<br>Insatisfeito</span></button>
            <button class="scale-btn" onclick="sel(this,2,'q1')">2<span class="scale-label">Insatisfeito</span></button>
            <button class="scale-btn" onclick="sel(this,3,'q1')">3<span class="scale-label">Neutro</span></button>
            <button class="scale-btn" onclick="sel(this,4,'q1')">4<span class="scale-label">Satisfeito</span></button>
            <button class="scale-btn" onclick="sel(this,5,'q1')">5<span class="scale-label">Muito<br>Satisfeito</span></button>
          </div>
        </div>
        <div class="question-item">
          <div class="question-text">2. Recebo feedback sobre meu desempenho.</div>
          <div class="scale-row">
            <button class="scale-btn" onclick="sel(this,1,'q2')">1<span class="scale-label">Muito<br>Insatisfeito</span></button>
            <button class="scale-btn" onclick="sel(this,2,'q2')">2<span class="scale-label">Insatisfeito</span></button>
            <button class="scale-btn" onclick="sel(this,3,'q2')">3<span class="scale-label">Neutro</span></button>
            <button class="scale-btn" onclick="sel(this,4,'q2')">4<span class="scale-label">Satisfeito</span></button>
            <button class="scale-btn" onclick="sel(this,5,'q2')">5<span class="scale-label">Muito<br>Satisfeito</span></button>
          </div>
        </div>
        <div class="question-item">
          <div class="question-text">3. Minha liderança trata os colaboradores com respeito.</div>
          <div class="scale-row">
