function renderDashboard() {
  const responses = getResponses();
  document.getElementById('responses-count').textContent = `${responses.length} resposta${responses.length !== 1 ? 's' : ''} registrada${responses.length !== 1 ? 's' : ''}`;

  if (responses.length === 0) {
