  document.getElementById('ai-ov').classList.add('on');
  document.getElementById('ai-ld').style.display='flex';
  document.getElementById('ai-ct').style.display='none';

  const {catAvg,overall}=calcStats(cachedResponses);
  const empresa=CFG.LABELS[dashEmpresa]?.nome||dashEmpresa;
  const abertas=cachedResponses.map(r=>({a:r.open1,b:r.open2,c:r.open3})).filter(o=>o.a||o.b||o.c).slice(0,20);

  fetch('https://api.anthropic.com/v1/messages',{method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({model:'claude-sonnet-4-6',max_tokens:1000,messages:[{role:'user',content:`
Você é especialista em clima organizacional. Analise os dados da empresa "${empresa}" e retorne APENAS JSON válido sem markdown:

${JSON.stringify({total:cachedResponses.length,geral:overall.toFixed(2),cats:CATS.map(c=>({nome:c.label,idx:catAvg[c.key].toFixed(2),cls:classify(catAvg[c.key]).label})),abertas})}

