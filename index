// ── export ────────────────────────────────────────
function exportExcel(){
  if(!cachedResponses.length){toast('Nenhuma resposta','err');return;}
  const {catAvg,overall}=calcStats(cachedResponses);
  const empresa=CFG.LABELS[dashEmpresa]?.nome||dashEmpresa;
  const wb=XLSX.utils.book_new();
  const s1=[['Relatório de Clima — '+empresa],['Gerado em',new Date().toLocaleString('pt-BR')],['Total',cachedResponses.length],[],
    ['Categoria','Índice','Classificação'],['Índice Geral',+overall.toFixed(2),classify(overall).label],
    ...CATS.map(c=>[c.label,+catAvg[c.key].toFixed(2),classify(catAvg[c.key]).label])];
  XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(s1),'Resumo');
  const headers=['Data/Hora',...QUESTIONS.map(q=>q.txt),'Faz Bem','Melhorar','Sugestões'];
  const rows=cachedResponses.map(r=>[
    new Date(r.ts_iso||r.ts).toLocaleString('pt-BR'),
    ...QUESTIONS.map(q=>r.answers?.[q.id]||''),r.open1||'',r.open2||'',r.open3||''
  ]);
  XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet([headers,...rows]),'Respostas');
  XLSX.writeFile(wb,`clima-${dashEmpresa}-${new Date().toISOString().split('T')[0]}.xlsx`);
}
function exportPDF(){
  if(!cachedResponses.length){toast('Nenhuma resposta','err');return;}
  const {catAvg,overall}=calcStats(cachedResponses);
  const empresa=CFG.LABELS[dashEmpresa]?.nome||dashEmpresa;
  const w=window.open('','_blank');
  w.document.write(`<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><title>Relatório Clima ${empresa}</title>
<style>body{font-family:Arial,sans-serif;padding:36px;color:#2C3447;max-width:800px;margin:0 auto}
h1{color:#1B3A6B;font-size:18px;border-bottom:2px solid #1B3A6B;padding-bottom:7px;margin-bottom:14px}
h2{color:#1B3A6B;font-size:13px;margin-top:18px;margin-bottom:5px}
table{width:100%;border-collapse:collapse;margin-top:6px}th{background:#1B3A6B;color:#fff;padding:6px 10px;text-align:left;font-size:11px}
td{padding:6px 10px;border-bottom:1px solid #E8ECF2;font-size:12px}tr:nth-child(even) td{background:#F5F7FA}
.badge{padding:2px 7px;border-radius:99px;font-size:10px;font-weight:700}
.excellent{background:#E8F5EF;color:#2E7D5E}.good{background:#E8F5EF;color:#3AA76D}
.attention{background:#FEF3DC;color:#c47d0a}.critical{background:#FDECEA;color:#C0392B}
.info{background:#EBF0FA;padding:12px 14px;border-radius:7px;margin-bottom:16px;font-size:12px;line-height:1.6}
blockquote{border-left:3px solid #2557A7;padding-left:8px;margin:3px 0;color:#5A6478;font-size:12px}
</style></head><body>
<h1>Relatório de Clima — ${empresa}</h1>
<div class="info"><strong>Gerado em:</strong> ${new Date().toLocaleString('pt-BR')}&nbsp;&nbsp;<strong>Respostas:</strong> ${cachedResponses.length}&nbsp;&nbsp;<strong>Índice Geral:</strong> ${overall.toFixed(2)} — ${classify(overall).label}</div>
<table><thead><tr><th>Categoria</th><th>Índice</th><th>Classificação</th></tr></thead><tbody>
${CATS.map(c=>{const s=catAvg[c.key],cl=classify(s);return`<tr><td>${c.label}</td><td>${s.toFixed(2)}</td><td><span class="badge ${cl.cls}">${cl.label}</span></td></tr>`;}).join('')}
</tbody></table>
<h2>O que a empresa faz bem</h2>${cachedResponses.filter(r=>r.open1).map(r=>`<blockquote>${esc(r.open1)}</blockquote>`).join('')||'<p style="font-size:12px;color:#9BA8BB">Sem respostas.</p>'}
<h2>O que precisa melhorar</h2>${cachedResponses.filter(r=>r.open2).map(r=>`<blockquote>${esc(r.open2)}</blockquote>`).join('')||'<p style="font-size:12px;color:#9BA8BB">Sem respostas.</p>'}
<h2>Sugestões para a diretoria</h2>${cachedResponses.filter(r=>r.open3).map(r=>`<blockquote>${esc(r.open3)}</blockquote>`).join('')||'<p style="font-size:12px;color:#9BA8BB">Sem respostas.</p>'}
<p style="margin-top:30px;font-size:10px;color:#9BA8BB;text-align:center">Pesquisa 100% anônima — Sinal Vida</p></body></html>`);
  w.document.close();setTimeout(()=>w.print(),600);
}

// ── utils ─────────────────────────────────────────
function esc(s){return(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function toast(msg,type=''){
  const t=document.getElementById('toast');
  t.textContent=msg;t.className='toast'+(type?' '+type:'');
  void t.offsetWidth;t.classList.add('on');
  setTimeout(()=>t.classList.remove('on'),3400);
}
</script>
</body>
</html>
