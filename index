<!-- Firebase -->
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getFirestore, collection, addDoc, getDocs, query, where, serverTimestamp }
  from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

// ══════════════════════════════════════════════════
//  🔥 CONFIGURAÇÃO FIREBASE — substitua pelos seus dados
//  1. Acesse https://console.firebase.google.com
//  2. Crie projeto → Web app → copie firebaseConfig
//  3. Firestore Database → Create database (modo produção)
//  4. Rules → altere para: allow read, write: if true;
// ══════════════════════════════════════════════════
const firebaseConfig = {
  apiKey: "AIzaSyAw36UYb-c3TWHKfvES5mWUMrptN8Jn4co",
  authDomain: "pesquisa-de-clima-da9cf.firebaseapp.com",
  projectId: "pesquisa-de-clima-da9cf",
  storageBucket: "pesquisa-de-clima-da9cf.firebasestorage.app",
  messagingSenderId: "491886415780",
  appId: "1:491886415780:web:6da5d441893d3c5695fb31",
  measurementId: "G-JSXSZ1QKCQ"
};
// ══════════════════════════════════════════════════

let db = null;
let firebaseOk = false;

try {
  const app = initializeApp(firebaseConfig);
  db = getFirestore(app);
  if (!firebaseConfig.apiKey.startsWith('COLE')) {
    firebaseOk = true;
    window._fbOk = true;
  }
} catch(e) { console.warn('Firebase não configurado:', e); }

window._saveResponse = async function(data) {
  if (!firebaseOk) throw new Error('firebase_not_configured');
  await addDoc(collection(db, 'respostas'), {
    ...data,
    ts: serverTimestamp()
  });
};

window._getResponses = async function(empresa) {
  if (!firebaseOk) throw new Error('firebase_not_configured');
  const q = query(collection(db, 'respostas'), where('empresa', '==', empresa));
  const snap = await getDocs(q);
  return snap.docs.map(d => ({ id: d.id, ...d.data() }));
};
</script>

<!-- Charts + XLSX -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

:root {
  --blue:#1B3A6B; --blue-m:#2557A7; --blue-l:#EBF0FA;
  --green:#2E7D5E; --green-l:#E8F5EF;
  --amber:#E8A020; --amber-l:#FEF3DC;
  --red:#C0392B;   --red-l:#FDECEA;
  --g100:#F5F7FA;  --g200:#E8ECF2; --g400:#9BA8BB;
  --g600:#5A6478;  --g800:#2C3447;
  --r:12px; --rs:8px;
  --sd:0 1px 4px rgba(27,58,107,.08);
  --sm:0 4px 16px rgba(27,58,107,.12);
  --sl:0 8px 32px rgba(27,58,107,.18);
}

/* ── grafica brand ── */
.brand-grafica  { --brand:#E07B00; --brand-l:#FFF3E0; --brand-m:#B86200; }
/* ── semaforica brand ── */
.brand-semaforica { --brand:#1B6B3A; --brand-l:#E8F5EF; --brand-m:#155230; }

*{box-sizing:border-box;margin:0;padding:0}
html,body{min-height:100%;font-family:'Inter',sans-serif;background:var(--g100);color:var(--g800)}

/* ────────────────── HEADER ────────────────── */
.hdr{
  background:var(--blue);color:#fff;
  padding:0 20px;height:54px;
  display:flex;align-items:center;justify-content:space-between;
  position:sticky;top:0;z-index:50;box-shadow:var(--sm)
}
.hdr-logo{display:flex;align-items:center;gap:9px;font-weight:700;font-size:14.5px}
.hdr-icon{width:30px;height:30px;background:var(--blue-m);border-radius:7px;
  display:flex;align-items:center;justify-content:center;font-size:15px}
.hdr-nav{display:flex;gap:3px}
.hdr-btn{padding:5px 12px;border-radius:6px;border:none;background:transparent;
  color:rgba(255,255,255,.6);font-family:inherit;font-size:12.5px;font-weight:500;
  cursor:pointer;transition:all .2s}
.hdr-btn:hover,.hdr-btn.on{background:rgba(255,255,255,.18);color:#fff}

/* ────────────────── VIEWS ────────────────── */
.view{display:none}.view.on{display:block}

/* ────────────────── COMPANY PICKER ────────────────── */
.pick-wrap{
  min-height:calc(100vh - 54px);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:32px 16px;
}
.pick-title{
  font-size:13px;font-weight:600;text-transform:uppercase;
  letter-spacing:.8px;color:var(--g400);margin-bottom:10px
}
.pick-heading{
  font-size:28px;font-weight:900;color:var(--blue);
  letter-spacing:-1px;margin-bottom:6px;text-align:center
}
.pick-sub{font-size:14px;color:var(--g600);margin-bottom:36px;text-align:center;line-height:1.6}

.pick-cards{display:flex;gap:18px;flex-wrap:wrap;justify-content:center}
.pick-card{
  width:240px;background:#fff;border-radius:16px;
  padding:28px 24px;border:2px solid var(--g200);
  cursor:pointer;transition:all .25s;text-align:center;
  box-shadow:var(--sd)
}
.pick-card:hover{transform:translateY(-4px);box-shadow:var(--sl)}
.pick-card.grafica:hover   {border-color:#E07B00}
.pick-card.semaforica:hover{border-color:#1B6B3A}
.pick-emoji{font-size:44px;margin-bottom:14px}
.pick-name{font-size:17px;font-weight:800;color:var(--blue);margin-bottom:6px}
.pick-desc{font-size:12.5px;color:var(--g600);line-height:1.5}
.pick-pill{
  display:inline-block;margin-top:14px;
  font-size:11px;font-weight:700;padding:4px 12px;
  border-radius:99px;text-transform:uppercase;letter-spacing:.4px
}
.pick-card.grafica   .pick-pill{background:#FFF3E0;color:#E07B00}
.pick-card.semaforica .pick-pill{background:#E8F5EF;color:#1B6B3A}

.pick-anon{
  margin-top:32px;background:var(--green-l);border:1.5px solid #a3d4bf;
  border-radius:var(--r);padding:14px 18px;max-width:460px;
  display:flex;gap:10px;align-items:flex-start
}
.pick-anon h4{font-size:12.5px;font-weight:700;color:var(--green);margin-bottom:3px}
.pick-anon p{font-size:12px;color:#3a6e57;line-height:1.5}

/* ────────────────── SURVEY ────────────────── */
.sv-wrap{max-width:680px;margin:0 auto;padding:22px 14px 60px}

.sv-company-badge{
  display:inline-flex;align-items:center;gap:7px;
  padding:6px 14px;border-radius:99px;
  font-size:12px;font-weight:700;margin-bottom:18px;
  border:1.5px solid
}
.sv-company-badge.grafica   {background:#FFF3E0;border-color:#f5c87a;color:#E07B00}
.sv-company-badge.semaforica{background:#E8F5EF;border-color:#a3d4bf;color:#1B6B3A}

.sv-title{font-size:22px;font-weight:800;color:var(--blue);letter-spacing:-.5px;margin-bottom:6px}
.sv-sub  {font-size:13px;color:var(--g600);line-height:1.55;margin-bottom:22px}

.prog-wrap{margin-bottom:20px}
.prog-row{display:flex;justify-content:space-between;font-size:11.5px;color:var(--g400);margin-bottom:6px;font-weight:500}
.prog-bar{height:5px;background:var(--g200);border-radius:99px;overflow:hidden}
.prog-fill{height:100%;background:linear-gradient(90deg,var(--blue-m),#4A90D9);border-radius:99px;transition:width .4s}

.sec{background:#fff;border-radius:var(--r);padding:20px;margin-bottom:14px;
  box-shadow:var(--sd);border:1px solid var(--g200)}
.sec-hd{display:flex;align-items:center;gap:9px;margin-bottom:16px}
.sec-ico{width:32px;height:32px;border-radius:7px;display:flex;align-items:center;
  justify-content:center;font-size:16px;background:var(--blue-l)}
.sec-hd h2{font-size:14.5px;font-weight:700;color:var(--blue)}

.qi{margin-bottom:15px}.qi:last-child{margin-bottom:0}
.qt{font-size:12.5px;color:var(--g800);margin-bottom:8px;font-weight:500;line-height:1.5}
.sr{display:flex;gap:4px}
.sb{flex:1;height:42px;border-radius:var(--rs);border:1.5px solid var(--g200);
  background:var(--g100);cursor:pointer;display:flex;flex-direction:column;
  align-items:center;justify-content:center;font-family:inherit;
  font-size:14px;font-weight:700;color:var(--g600);transition:all .15s}
.sb:hover{border-color:var(--blue-m);color:var(--blue-m);background:var(--blue-l)}
.sb.s1{background:#FDECEA;border-color:var(--red);color:var(--red)}
.sb.s2{background:#FEF3DC;border-color:var(--amber);color:#c47d0a}
.sb.s3{background:#F0EEF8;border-color:#7B6DC8;color:#5a50a0}
.sb.s4{background:#E8F5EF;border-color:#4aad82;color:#2a7d58}
.sb.s5{background:var(--blue-l);border-color:var(--blue-m);color:var(--blue-m)}
.sl_{font-size:8.5px;font-weight:400;line-height:1.2;text-align:center;margin-top:2px;display:none}
@media(min-width:430px){.sl_{display:block}}

.oq{margin-bottom:14px}.oq:last-child{margin-bottom:0}
.oq label{display:block;font-size:12.5px;font-weight:500;color:var(--g800);margin-bottom:6px;line-height:1.5}
.oq textarea{width:100%;min-height:76px;border:1.5px solid var(--g200);border-radius:var(--rs);
  padding:10px;font-family:inherit;font-size:12.5px;color:var(--g800);
  resize:vertical;background:var(--g100);transition:border-color .2s}
.oq textarea:focus{outline:none;border-color:var(--blue-m);background:#fff}
.oq textarea::placeholder{color:var(--g400)}

.submit-area{text-align:center;margin-top:24px}
.btn-p{background:var(--blue);color:#fff;border:none;padding:12px 36px;
  border-radius:var(--rs);font-family:inherit;font-size:14px;font-weight:600;
  cursor:pointer;transition:all .2s;box-shadow:0 4px 12px rgba(27,58,107,.28)}
.btn-p:hover{background:var(--blue-m);transform:translateY(-1px)}
.btn-p:disabled{opacity:.55;cursor:not-allowed;transform:none}

.spl-screen{display:none;text-align:center;padding:52px 20px;background:#fff;
  border-radius:var(--r);box-shadow:var(--sd)}
.spl-screen.on{display:block}
.spl-ico{font-size:52px;margin-bottom:14px}

/* ────────────────── LOGIN ────────────────── */
.login-ov{display:none;position:fixed;inset:0;background:rgba(27,58,107,.6);
  z-index:200;align-items:center;justify-content:center;backdrop-filter:blur(4px)}
.login-ov.on{display:flex}
.login-box{background:#fff;border-radius:16px;padding:32px 28px;
  max-width:350px;width:100%;box-shadow:var(--sl);text-align:center}
.login-box h2{font-size:18px;font-weight:800;color:var(--blue);margin-bottom:5px}
.login-box p{font-size:12.5px;color:var(--g600);margin-bottom:20px}
.login-box input{width:100%;padding:11px 13px;border:1.5px solid var(--g200);
  border-radius:var(--rs);font-family:inherit;font-size:13.5px;
  margin-bottom:10px;outline:none;transition:border-color .2s}
.login-box input:focus{border-color:var(--blue-m)}
.login-err{color:var(--red);font-size:12px;margin-bottom:8px;display:none}
.login-err.on{display:block}

/* ────────────────── DASHBOARD ────────────────── */
.db-wrap{padding:20px 14px 60px;max-width:1200px;margin:0 auto}

/* Setup warning */
.setup-warn{
  background:#fff8e1;border:1.5px solid #ffc107;border-radius:var(--rs);
  padding:12px 16px;margin-bottom:16px;font-size:12.5px;line-height:1.6;
  display:none
}
.setup-warn.on{display:block}
.setup-warn a{color:var(--blue-m)}

.db-topbar{display:flex;align-items:flex-start;justify-content:space-between;
  margin-bottom:20px;flex-wrap:wrap;gap:10px}
.db-topbar h1{font-size:19px;font-weight:800;color:var(--blue)}
.db-company-tag{
  display:inline-flex;align-items:center;gap:6px;margin-top:4px;
  font-size:11px;font-weight:700;padding:3px 10px;border-radius:99px
}
.db-company-tag.grafica   {background:#FFF3E0;color:#E07B00;border:1px solid #f5c87a}
.db-company-tag.semaforica{background:#E8F5EF;color:#1B6B3A;border:1px solid #a3d4bf}

.rc{background:var(--blue-l);color:var(--blue-m);font-size:11px;font-weight:600;
  padding:3px 10px;border-radius:99px;display:inline-block;margin-top:3px}

.db-acts{display:flex;gap:6px;flex-wrap:wrap}
.btn-o{background:#fff;border:1.5px solid var(--g200);color:var(--g600);
  padding:7px 13px;border-radius:var(--rs);font-family:inherit;font-size:12.5px;
  font-weight:500;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:5px}
.btn-o:hover{border-color:var(--blue-m);color:var(--blue-m);background:var(--blue-l)}
.btn-ai{background:linear-gradient(135deg,#2557A7,#4A90D9);color:#fff;border:none;
  padding:7px 14px;border-radius:var(--rs);font-family:inherit;font-size:12.5px;
  font-weight:600;cursor:pointer;transition:all .2s;box-shadow:0 2px 8px rgba(37,87,167,.28)}
.btn-ai:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(37,87,167,.38)}
.btn-d{background:var(--red-l);border:1.5px solid #e8b4b0;color:var(--red);
  padding:7px 13px;border-radius:var(--rs);font-family:inherit;font-size:12.5px;
  font-weight:600;cursor:pointer;transition:all .2s}
.btn-d:hover{background:var(--red);color:#fff}

/* Loading state */
.db-loading{text-align:center;padding:52px 20px;background:#fff;border-radius:var(--r);
  box-shadow:var(--sd)}
.spin{width:36px;height:36px;border:3px solid var(--blue-l);border-top-color:var(--blue-m);
  border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 14px}
@keyframes spin{to{transform:rotate(360deg)}}

.empty-st{text-align:center;padding:52px 20px;background:#fff;border-radius:var(--r);
  box-shadow:var(--sd);border:1px solid var(--g200)}
.empty-st .ico{font-size:42px;margin-bottom:13px}
.empty-st h3{font-size:16px;font-weight:700;color:var(--blue);margin-bottom:6px}
.empty-st p{color:var(--g600);font-size:13px;line-height:1.6}

/* Metrics */
.mg{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:18px}
.mc{background:#fff;border-radius:var(--r);padding:16px;box-shadow:var(--sd);
  border:1px solid var(--g200);position:relative;overflow:hidden}
.mc::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;border-radius:var(--r) var(--r) 0 0}
.mc.excellent::before{background:var(--green)}.mc.good::before{background:#3AA76D}
.mc.attention::before{background:var(--amber)}.mc.critical::before{background:var(--red)}
.ml{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:var(--g400);margin-bottom:6px}
.mv{font-size:28px;font-weight:800;letter-spacing:-1px;line-height:1}
.mv.excellent{color:var(--green)}.mv.good{color:#3AA76D}
.mv.attention{color:var(--amber)}.mv.critical{color:var(--red)}
.mb_{display:inline-block;margin-top:5px;font-size:10px;font-weight:700;padding:2px 7px;
  border-radius:99px;text-transform:uppercase;letter-spacing:.3px}
.mb_.excellent{background:var(--green-l);color:var(--green)}.mb_.good{background:#E8F5EF;color:#3AA76D}
.mb_.attention{background:var(--amber-l);color:#c47d0a}.mb_.critical{background:var(--red-l);color:var(--red)}

/* Grid */
.dg{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
@media(max-width:720px){.dg{grid-template-columns:1fr}}
.dc{background:#fff;border-radius:var(--r);padding:16px;box-shadow:var(--sd);border:1px solid var(--g200)}
.dc.full{grid-column:1/-1}
.dc h3{font-size:13px;font-weight:700;color:var(--blue);margin-bottom:13px;display:flex;align-items:center;gap:7px}
.dc h3 .badge{background:var(--blue-l);color:var(--blue-m);font-size:9.5px;padding:2px 7px;border-radius:99px;font-weight:600}

/* Ranking */
.rl{display:flex;flex-direction:column;gap:6px}
.ri{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:var(--rs);background:var(--g100);border:1px solid var(--g200)}
.rp{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;flex-shrink:0}
.rn{flex:1;font-size:12px;font-weight:500}
.rs_{font-size:14px;font-weight:800}
.rb_{flex:0 0 60px;height:5px;background:var(--g200);border-radius:99px;overflow:hidden}
.rb_ div{height:100%;border-radius:99px}

/* Heatmap */
.hm-grid{display:grid;gap:3px}
.hm-row{display:grid;grid-template-columns:165px repeat(5,1fr);gap:3px;align-items:center}
.hm-label{font-size:10.5px;color:var(--g600);font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:5px}
.hm-cell{height:24px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:600;color:#fff;cursor:default;transition:transform .15s}
.hm-cell:hover{transform:scale(1.08)}
.hm-hdr{display:grid;grid-template-columns:165px repeat(5,1fr);gap:3px;margin-bottom:3px}
.hm-hdr span{text-align:center;font-size:9px;font-weight:700;color:var(--g400);text-transform:uppercase;letter-spacing:.4px}

/* Open answers */
.oa-list{display:flex;flex-direction:column;gap:6px}
.oa-item{padding:9px 12px;background:var(--g100);border-radius:var(--rs);border-left:3px solid var(--blue-m);font-size:12.5px;line-height:1.6;color:var(--g600)}

/* ────────────────── AI MODAL ────────────────── */
.ai-ov{display:none;position:fixed;inset:0;background:rgba(27,58,107,.5);z-index:200;
  align-items:center;justify-content:center;padding:14px;backdrop-filter:blur(3px)}
.ai-ov.on{display:flex}
.ai-modal{background:#fff;border-radius:16px;max-width:780px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:var(--sl)}
.ai-hdr{background:linear-gradient(135deg,var(--blue),var(--blue-m));color:#fff;padding:20px;border-radius:16px 16px 0 0;display:flex;justify-content:space-between;align-items:flex-start}
.ai-hdr h2{font-size:16px;font-weight:800;margin-bottom:3px}
.ai-hdr p{font-size:11px;opacity:.75}
.btn-x{background:rgba(255,255,255,.2);border:none;color:#fff;width:28px;height:28px;border-radius:50%;cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ai-body{padding:20px}
.ai-sec{margin-bottom:16px}
.ai-sec-t{display:flex;align-items:center;gap:6px;font-size:12.5px;font-weight:700;color:var(--blue);margin-bottom:9px;padding-bottom:6px;border-bottom:1px solid var(--g200)}
.ai-ld{display:flex;flex-direction:column;align-items:center;padding:32px;text-align:center;gap:10px}
.ai-c p{font-size:12.5px;line-height:1.7;color:var(--g800);margin-bottom:6px}
.ai-c ul{padding-left:17px}
.ai-c li{font-size:12.5px;line-height:1.7;color:var(--g800);margin-bottom:3px}
.at{width:100%;border-collapse:collapse;font-size:12px;margin-top:6px}
.at th{background:var(--blue);color:#fff;padding:7px 10px;text-align:left;font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.3px}
.at td{padding:7px 10px;border-bottom:1px solid var(--g200)}
.at tr:nth-child(even) td{background:var(--g100)}
.pb{padding:2px 7px;border-radius:99px;font-size:10px;font-weight:700}
.pa{background:var(--red-l);color:var(--red)}.pm{background:var(--amber-l);color:#c47d0a}.pb_{background:var(--green-l);color:var(--green)}

/* ────────────────── TOAST ────────────────── */
.toast{position:fixed;bottom:20px;right:20px;padding:11px 18px;border-radius:var(--rs);
  font-size:13px;font-weight:500;box-shadow:var(--sl);z-index:999;
  transform:translateY(70px);opacity:0;transition:all .3s;
  pointer-events:none;max-width:320px;color:#fff;background:var(--g800)}
.toast.on{transform:translateY(0);opacity:1}
.toast.ok{background:var(--green)}.toast.err{background:var(--red)}.toast.warn{background:var(--amber)}

@media(max-width:480px){
  .hm-row,.hm-hdr{grid-template-columns:95px repeat(5,1fr)}
  .hm-label{font-size:9px}
  .pick-card{width:100%;max-width:320px}
}
</style>
</head>
<body>

<!-- ═══ HEADER ═══ -->
<header class="hdr">
  <div class="hdr-logo">
    <div class="hdr-icon">🌡️</div>
    <span>Clima Organizacional</span>
  </div>
  <nav class="hdr-nav">
